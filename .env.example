# Norbu Buddhist Handicraft - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real secrets!

# Supabase (Public - safe to expose in browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Turnstile (Public site key - safe to expose in browser)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Cloudflare Pages Functions Secrets (Set in Cloudflare Dashboard - NEVER in .env)
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin (Configured in Supabase Auth - not in env)
# ADMIN_EMAIL=admin@norbu.example.com